# Dependencies
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Tripo source meshes — ~60 MB each, and the deployable artefact is the baked
# icon under assets/items/icons/. The sibling .json keeps the task id so any
# mesh can be re-downloaded (threejs_3d_asset.py download TASK_ID).
art-source/**/*.glb
# Tripo's intermediate concept render — 4+ MB per set and not an input to
# anything; the .json task id plus prompts.json is what regeneration needs.
art-source/**/*generated_image.jpeg

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage/

# Misc
.cache/
.temp/ 
.vercel

